APP_NAME="E-Billing"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-ebilling-domain.example
APP_FORCE_HTTPS=true

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
# Nixpacks PHP currently works with MariaDB, or with MySQL users that do not
# require caching_sha2_password. MySQL 8 default users may fail to authenticate.
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log

INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0

TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_BASE_URL=https://tripay.co.id/api

WHATSPIE_API_KEY=
WHATSPIE_DEVICE_ID=

LEGACY_SCRAPER_URL=

VITE_APP_NAME="${APP_NAME}"
